---
import BaseLayout from "../layouts/BaseLayout.astro";

const LOGO_SRC = "/cameracentralLOGO.png";
---

<BaseLayout title="Camera Central">
  <main class="space-y-24">
    <!-- HERO -->
    <section class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-16 items-center">
      <!-- Hero text -->
      <div class="max-w-3xl">
        <p class="mb-4 text-sm font-medium uppercase tracking-[0.18em] text-gray-500">
          Find your camera
        </p>

        <h1 class="font-semibold tracking-tight leading-[1.02] text-5xl md:text-6xl lg:text-7xl">
          Find the camera that fits how you shoot.
        </h1>

        <p class="mt-6 text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl">
          Tell us what you photograph, what matters to you, and your budget.
          Camera Central narrows the field down to the cameras that actually
          make sense for you.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href="/find"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-black px-6 py-3 text-base font-medium text-white transition hover:bg-gray-800"
          >
            Find my camera
            <span aria-hidden="true">→</span>
          </a>

          <span class="text-sm text-gray-500">
            About 2 minutes · No signup
          </span>
        </div>

        <a
          href="/How-to-choose-a-camera"
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gray-700 transition hover:text-black"
        >
          Learn how to choose a camera
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Hero visual -->
      <div class="relative">
        <div
          class="relative overflow-hidden rounded-[2rem] border border-gray-200 bg-gradient-to-br from-gray-50 via-white to-gray-100 min-h-[420px] md:min-h-[500px] flex items-center justify-center"
        >
          <div class="absolute inset-0 opacity-60">
            <div class="absolute -top-20 -right-20 h-72 w-72 rounded-full bg-gray-200 blur-3xl"></div>
            <div class="absolute -bottom-24 -left-20 h-72 w-72 rounded-full bg-gray-100 blur-3xl"></div>
          </div>

          <img
            src={LOGO_SRC}
            alt="Camera Central"
            class="relative z-10 w-[250px] md:w-[310px] lg:w-[340px] h-auto opacity-95 select-none"
          />
        </div>
      </div>
    </section>

    <!-- SHOOTING CATEGORIES -->
    <section>
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-500 mb-3">
            Start with what you shoot
          </p>

          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">
            What do you want to photograph?
          </h2>
        </div>

        <p class="text-gray-600 max-w-xl">
          Different subjects demand different strengths. Your ideal camera
          depends on what you actually want to create.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <a
          href="/find"
          class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="text-3xl mb-10">✈️</div>
          <h3 class="text-xl font-semibold">Travel</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Lightweight bodies, compact lenses, strong stabilization, and easy
            everyday carry.
          </p>
          <span class="mt-6 inline-flex text-sm font-medium group-hover:underline">
            Find a travel camera →
          </span>
        </a>

        <a
          href="/find"
          class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="text-3xl mb-10">🦅</div>
          <h3 class="text-xl font-semibold">Wildlife</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Fast autofocus, burst speed, reach, and handling for unpredictable
            subjects.
          </p>
          <span class="mt-6 inline-flex text-sm font-medium group-hover:underline">
            Find a wildlife camera →
          </span>
        </a>

        <a
          href="/find"
          class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="text-3xl mb-10">👤</div>
          <h3 class="text-xl font-semibold">Portraits</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Great skin tones, subject detection, lens options, and strong
            low-light image quality.
          </p>
          <span class="mt-6 inline-flex text-sm font-medium group-hover:underline">
            Find a portrait camera →
          </span>
        </a>

        <a
          href="/find"
          class="group rounded-2xl border border-gray-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg"
        >
          <div class="text-3xl mb-10">🎥</div>
          <h3 class="text-xl font-semibold">Video</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Strong autofocus, stabilization, recording options, and dependable
            thermals.
          </p>
          <span class="mt-6 inline-flex text-sm font-medium group-hover:underline">
            Find a video camera →
          </span>
        </a>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="rounded-[2rem] bg-gray-950 px-6 py-12 md:px-10 md:py-14 text-white">
      <div class="max-w-2xl">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-400 mb-3">
          How Camera Central works
        </p>

        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">
          Skip the spec-sheet overload.
        </h2>

        <p class="mt-4 text-gray-400 leading-relaxed">
          Camera Central turns your priorities into a short list instead of
          making you compare dozens of nearly identical models yourself.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">01</span>
          <h3 class="mt-3 text-xl font-semibold">Tell us how you shoot</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Choose your subjects, experience level, priorities, and budget.
          </p>
        </div>

        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">02</span>
          <h3 class="mt-3 text-xl font-semibold">We compare the tradeoffs</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Your answers are weighed against real differences between cameras.
          </p>
        </div>

        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">03</span>
          <h3 class="mt-3 text-xl font-semibold">Get your best matches</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            See a focused recommendation with the reasoning behind each choice.
          </p>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="text-center max-w-3xl mx-auto pb-8">
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-gray-500 mb-3">
        Ready to narrow it down?
      </p>

      <h2 class="text-4xl md:text-5xl font-semibold tracking-tight">
        Your next camera is easier to find than you think.
      </h2>

      <p class="mt-5 text-lg text-gray-600">
        Answer a few questions and get a short list built around how you
        actually shoot.
      </p>

      <a
        href="/find"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-black px-6 py-3 text-base font-medium text-white transition hover:bg-gray-800"
      >
        Take the camera quiz
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</BaseLayout>