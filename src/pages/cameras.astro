---
import BaseLayout from "../layouts/BaseLayout.astro";
import camerasData from "../data/camera";

const title = "Browse All Cameras";
const description =
  "Search and browse every camera in the Camera Central database.";

const CAMERAS = Array.isArray(camerasData) ? camerasData : [];

const brands = [...new Set(CAMERAS.map((c) => c.brand).filter(Boolean))].sort();
const sensors = [...new Set(CAMERAS.map((c) => c.sensor).filter(Boolean))].sort();
---

<BaseLayout title={title} description={description}>
  <section class="px-4 py-12 md:px-6 lg:py-16">
    <div class="mx-auto max-w-6xl space-y-8">
      <header class="space-y-4">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">
          Camera Database
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 md:text-5xl">
          {title}
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-gray-700">
          Search by brand or model, then narrow things down by sensor, type, or budget.
        </p>
      </header>

      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm md:p-6">
        <div class="grid gap-4 md:grid-cols-4">
          <div class="md:col-span-2">
            <label for="cameraSearch" class="mb-2 block text-sm font-medium text-gray-700">
              Search
            </label>
            <input
              id="cameraSearch"
              type="text"
              placeholder="Search Canon R8, Sony, Fujifilm, etc."
              class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-500"
            />
          </div>

          <div>
            <label for="brandFilter" class="mb-2 block text-sm font-medium text-gray-700">
              Brand
            </label>
            <select
              id="brandFilter"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-500"
            >
              <option value="">All brands</option>
              {brands.map((brand) => <option value={brand}>{brand}</option>)}
            </select>
          </div>

          <div>
            <label for="typeFilter" class="mb-2 block text-sm font-medium text-gray-700">
              Type
            </label>
            <select
              id="typeFilter"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-500"
            >
              <option value="">All types</option>
              <option value="detachable">Detachable-lens</option>
              <option value="fixed">Fixed-lens</option>
            </select>
          </div>

          <div>
            <label for="sensorFilter" class="mb-2 block text-sm font-medium text-gray-700">
              Sensor
            </label>
            <select
              id="sensorFilter"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-500"
            >
              <option value="">All sensors</option>
              {sensors.map((sensor) => <option value={sensor}>{sensor}</option>)}
            </select>
          </div>

          <div>
            <label for="budgetFilter" class="mb-2 block text-sm font-medium text-gray-700">
              Budget
            </label>
            <select
              id="budgetFilter"
              class="w-full rounded-xl border border-gray-300 px-4 py-3 outline-none transition focus:border-gray-500"
            >
              <option value="">All budgets</option>
              <option value="1000">Under $1,000</option>
              <option value="1800">$1,000–$1,800</option>
              <option value="2800">$1,800–$2,800</option>
              <option value="2801">$2,800+</option>
            </select>
          </div>

          <div class="flex items-end">
            <button
              id="clearFilters"
              type="button"
              class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 font-medium text-gray-900 transition hover:bg-gray-50"
            >
              Clear filters
            </button>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <p id="cameraCount" class="text-sm text-gray-600"></p>
      </div>

      <div
        id="cameraGrid"
        class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3"
      ></div>

      <div
        id="emptyState"
        class="hidden rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-sm"
      >
        <h2 class="text-xl font-semibold text-gray-900">No cameras found</h2>
        <p class="mt-2 text-gray-600">
          Try clearing filters or searching for a broader term.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ CAMERAS }} is:inline>
    const searchEl = document.getElementById("cameraSearch");
    const brandEl = document.getElementById("brandFilter");
    const typeEl = document.getElementById("typeFilter");
    const sensorEl = document.getElementById("sensorFilter");
    const budgetEl = document.getElementById("budgetFilter");
    const clearEl = document.getElementById("clearFilters");
    const countEl = document.getElementById("cameraCount");
    const gridEl = document.getElementById("cameraGrid");
    const emptyEl = document.getElementById("emptyState");

    function escapeHtml(str) {
      return String(str)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function priceText(price) {
      return typeof price === "number" ? `$${price.toLocaleString()}` : "Price unavailable";
    }

    function cardHtml(c) {
      const sensor = c.sensor ? escapeHtml(c.sensor) : "—";
      const system = c.system ? escapeHtml(c.system) : "—";
      const mp = typeof c.mp === "number" ? `${c.mp} MP` : "—";
      const price = priceText(c.price);
      const image = c.image ? escapeHtml(c.image) : "";
      const imageAlt = c.imageAlt ? escapeHtml(c.imageAlt) : "Camera";

      return `
        <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
          ${
            image
              ? `
            <img
              src="${image}"
              alt="${imageAlt}"
              loading="lazy"
              class="mb-4 h-48 w-full rounded-xl border border-gray-200 bg-gray-50 object-contain"
              onerror="this.style.display='none';"
            />
          `
              : ""
          }

          <div class="space-y-2">
            <h2 class="text-xl font-semibold text-gray-900">
              ${escapeHtml(c.brand || "")} ${escapeHtml(c.model || "")}
            </h2>

            <p class="text-sm text-gray-600">
              ${system} • ${sensor} • ${mp}
            </p>

            <p class="text-sm text-gray-500">
              ${price}
            </p>
          </div>
        </div>
      `;
    }

    function matchesBudget(camera, budgetValue) {
      if (!budgetValue) return true;
      if (typeof camera.price !== "number") return true;

      if (budgetValue === "1000") return camera.price < 1000;
      if (budgetValue === "1800") return camera.price >= 1000 && camera.price <= 1800;
      if (budgetValue === "2800") return camera.price > 1800 && camera.price <= 2800;
      if (budgetValue === "2801") return camera.price > 2800;

      return true;
    }

    function renderCameras() {
      const search = (searchEl.value || "").trim().toLowerCase();
      const brand = brandEl.value;
      const type = typeEl.value;
      const sensor = sensorEl.value;
      const budget = budgetEl.value;

      const filtered = CAMERAS.filter((c) => {
        const brandModel = `${c.brand || ""} ${c.model || ""}`.toLowerCase();

        if (search && !brandModel.includes(search)) return false;
        if (brand && c.brand !== brand) return false;
        if (type && c.cameraType !== type) return false;
        if (sensor && c.sensor !== sensor) return false;
        if (!matchesBudget(c, budget)) return false;

        return true;
      });

      countEl.textContent =
        filtered.length === 1
          ? "1 camera found"
          : `${filtered.length} cameras found`;

      gridEl.innerHTML = filtered.map(cardHtml).join("");
      emptyEl.classList.toggle("hidden", filtered.length !== 0);
    }

    [searchEl, brandEl, typeEl, sensorEl, budgetEl].forEach((el) => {
      el.addEventListener("input", renderCameras);
      el.addEventListener("change", renderCameras);
    });

    clearEl.addEventListener("click", () => {
      searchEl.value = "";
      brandEl.value = "";
      typeEl.value = "";
      sensorEl.value = "";
      budgetEl.value = "";
      renderCameras();
    });

    renderCameras();
  </script>
</BaseLayout>