---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Camera Central — Find the Right Camera"
  description="Find the camera that fits how you shoot. Camera Central compares your priorities and recommends the cameras that make the most sense for you."
>
  <main class="space-y-20 lg:space-y-24">

    <!-- =====================================================
         HERO
    ====================================================== -->
    <section
      class="grid grid-cols-1 lg:grid-cols-[1.02fr_0.98fr] gap-10 lg:gap-16 items-center"
    >
      <!-- Left: copy -->
      <div class="max-w-3xl">
        <p
          class="mb-4 text-sm font-medium uppercase tracking-[0.2em] text-gray-500"
        >
          Find your camera
        </p>

        <h1
          class="font-semibold tracking-tight leading-[1.02] text-5xl md:text-6xl lg:text-6xl"
        >
          Find the camera that fits how you shoot.
        </h1>

        <p
          class="mt-6 text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl"
        >
          Tell us what you photograph, what matters to you, and your budget.
          Camera Central narrows the field down to the cameras that actually
          make sense for you.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
          <a
            href="/find"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-black px-6 py-3 text-base font-medium text-white transition hover:bg-gray-800 hover:-translate-y-0.5"
          >
            Find my camera
            <span aria-hidden="true">→</span>
          </a>

          <span class="text-sm text-gray-500">
            About 2 minutes · No signup
          </span>
        </div>

        <a
          href="/How-to-choose-a-camera"
          class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gray-700 transition hover:text-black"
        >
          Learn how to choose a camera
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Right: photography -->
      <div class="relative">
        <div
          class="group relative overflow-hidden rounded-[2rem] min-h-[420px] md:min-h-[520px] shadow-[0_20px_60px_rgba(15,23,42,0.14)]"
        >
          <img
            src="/images/article_pictures/splitrock-picture.JPG"
            alt="Landscape photography"
            class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
            loading="eager"
          />

          <!-- Slight gradient for depth -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"
          ></div>

          
        </div>
      </div>
    </section>


    <!-- =====================================================
         SHOOTING CATEGORIES
    ====================================================== -->
    <section>
      <div
        class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-8"
      >
        <div>
          <p
            class="text-sm font-medium uppercase tracking-[0.2em] text-gray-500 mb-3"
          >
            Start with what you shoot
          </p>

          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">
            What do you want to photograph?
          </h2>
        </div>

        <p class="text-gray-600 max-w-xl leading-relaxed">
          Different subjects demand different strengths. Your ideal camera
          depends on what you actually want to create.
        </p>
      </div>


      <!-- Category cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

        <!-- TRAVEL -->
        <a
          href="/find"
          class="group overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="h-44 overflow-hidden bg-gray-100">
            <img
              src="/images/article_pictures/niagara-camera.jpg"
              alt="Travel photography"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <h3 class="text-xl font-semibold">
              Travel
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Lightweight bodies, compact lenses, strong stabilization, and
              easy everyday carry.
            </p>

            <span
              class="mt-6 inline-flex items-center gap-1 text-sm font-medium"
            >
              Find a travel camera
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>


        <!-- WILDLIFE -->
        <a
          href="/find"
          class="group overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="h-44 overflow-hidden bg-gray-100">
            <img
              src="/images/article_pictures/wolf-picture.JPG"
              alt="Wildlife photography"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <h3 class="text-xl font-semibold">
              Wildlife
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Fast autofocus, burst speed, reach, and handling for unpredictable
              subjects.
            </p>

            <span
              class="mt-6 inline-flex items-center gap-1 text-sm font-medium"
            >
              Find a wildlife camera
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>


        <!-- PORTRAITS -->
        <a
          href="/find"
          class="group overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="h-44 overflow-hidden bg-gray-100">
            <img
              src="/images/article_pictures/splitrock-picture.JPG"
              alt="Portrait photography"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <h3 class="text-xl font-semibold">
              Portraits
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Great skin tones, subject detection, lens options, and strong
              low-light image quality.
            </p>

            <span
              class="mt-6 inline-flex items-center gap-1 text-sm font-medium"
            >
              Find a portrait camera
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>


        <!-- VIDEO -->
        <a
          href="/find"
          class="group overflow-hidden rounded-2xl border border-gray-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="h-44 overflow-hidden bg-gray-100">
            <img
              src="/images/article_pictures/niagara-camera.jpg"
              alt="Video and filmmaking"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </div>

          <div class="p-5">
            <h3 class="text-xl font-semibold">
              Video
            </h3>

            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Strong autofocus, stabilization, recording options, and dependable
              thermals.
            </p>

            <span
              class="mt-6 inline-flex items-center gap-1 text-sm font-medium"
            >
              Find a video camera
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

      </div>
    </section>


    <!-- =====================================================
         HOW CAMERA CENTRAL WORKS
    ====================================================== -->
    <section
      class="rounded-[2rem] bg-gray-950 px-6 py-12 md:px-10 md:py-14 text-white"
    >
      <div class="max-w-2xl">
        <p
          class="text-sm font-medium uppercase tracking-[0.2em] text-gray-400 mb-3"
        >
          How Camera Central works
        </p>

        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">
          Skip the spec-sheet overload.
        </h2>

        <p class="mt-4 text-gray-400 leading-relaxed">
          Camera Central turns your priorities into a short list instead of
          making you compare dozens of nearly identical models yourself.
        </p>
      </div>


      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-8">

        <!-- Step 1 -->
        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">
            01
          </span>

          <h3 class="mt-3 text-xl font-semibold">
            Tell us how you shoot
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Choose your subjects, experience level, priorities, and budget.
          </p>
        </div>


        <!-- Step 2 -->
        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">
            02
          </span>

          <h3 class="mt-3 text-xl font-semibold">
            We compare the tradeoffs
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            Your answers are weighed against real differences between cameras.
          </p>
        </div>


        <!-- Step 3 -->
        <div class="border-t border-gray-700 pt-5">
          <span class="text-sm text-gray-500">
            03
          </span>

          <h3 class="mt-3 text-xl font-semibold">
            Get your best matches
          </h3>

          <p class="mt-2 text-sm leading-relaxed text-gray-400">
            See a focused recommendation with the reasoning behind each choice.
          </p>
        </div>

      </div>
    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->
    <section class="text-center max-w-3xl mx-auto pb-4">
      <p
        class="text-sm font-medium uppercase tracking-[0.2em] text-gray-500 mb-3"
      >
        Ready to narrow it down?
      </p>

      <h2 class="text-4xl md:text-5xl font-semibold tracking-tight">
        Your next camera is easier to find than you think.
      </h2>

      <p class="mt-5 text-lg text-gray-600">
        Answer a few questions and get a short list built around how you
        actually shoot.
      </p>

      <a
        href="/find"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-black px-6 py-3 text-base font-medium text-white transition hover:bg-gray-800 hover:-translate-y-0.5"
      >
        Take the camera quiz
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </main>
</BaseLayout>