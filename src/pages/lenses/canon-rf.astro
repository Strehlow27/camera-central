---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LENSES } from "../../data/LENSES.js";
import { CAMERAS } from "../../data/cameras.js";

const rfLenses = (Array.isArray(LENSES) ? LENSES : [])
  .filter((l) => l.mount === "RF" || l.mount === "RF-S")
  .sort((a, b) => {
    const aPrice = typeof a.price === "number" ? a.price : 999999;
    const bPrice = typeof b.price === "number" ? b.price : 999999;
    return aPrice - bPrice;
  });

const canonRFBodies = (Array.isArray(CAMERAS) ? CAMERAS : [])
  .filter((c) => c.brand === "Canon" && c.mount === "RF")
  .slice(0, 6);
---

<BaseLayout
  title="Canon RF Lenses – Camera Central"
  description="Browse Canon RF and RF-S lenses compatible with Canon mirrorless cameras."
>
  <div class="w-full max-w-5xl mx-auto space-y-8">
    <section class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-medium text-gray-500">Lens System</p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900">
        Canon RF / RF-S Lenses
      </h1>

      <p class="mt-3 max-w-2xl text-gray-600">
        Browse native Canon mirrorless lenses for cameras like the R50, R10, R7, R8, R6 Mark II,
        and R5. RF lenses are the most future-proof option in Canon’s current mirrorless system.
      </p>

      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/lenses"
          class="inline-flex items-center rounded-xl border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 transition hover:bg-gray-50"
        >
          ← Back to lens systems
        </a>

        <a
          href="/find"
          class="inline-flex items-center rounded-xl border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 transition hover:bg-gray-50"
        >
          Take the quiz
        </a>
      </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Browse lenses</h2>
          <p class="mt-1 text-sm text-gray-600">
            Filter by lens type and sort by price or weight.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <label class="text-sm text-gray-700">
            <span class="mb-1 block font-medium">Category</span>
            <select
              id="lensCategoryFilter"
              class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900"
            >
              <option value="all">All categories</option>
              <option value="standard">Standard / everyday</option>
              <option value="wide">Wide angle</option>
              <option value="telephoto">Telephoto</option>
            </select>
          </label>

          <label class="text-sm text-gray-700">
            <span class="mb-1 block font-medium">Sort by</span>
            <select
              id="lensSort"
              class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900"
            >
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
              <option value="weight-asc">Weight: lightest first</option>
              <option value="weight-desc">Weight: heaviest first</option>
            </select>
          </label>
        </div>
      </div>
    </section>

    <section
      id="lensGrid"
      class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      data-lenses={JSON.stringify(rfLenses)}
    >
      {rfLenses.map((lens) => (
        <article
          class="lens-card rounded-2xl border border-gray-200 bg-white p-5 shadow-sm"
          data-category={lens.category ?? ""}
          data-price={typeof lens.price === "number" ? lens.price : ""}
          data-weight={typeof lens.weightGrams === "number" ? lens.weightGrams : ""}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500">
                {lens.category || "Lens"}
              </p>

              <h2 class="mt-1 text-lg font-semibold text-gray-900">
                {lens.brand} {lens.name}
              </h2>

              <p class="mt-1 text-sm text-gray-600">
                {lens.mount} mount • {lens.sensorCoverage || "Coverage not listed"}
              </p>
            </div>

            {lens.futureProof ? (
              <span class="rounded-full bg-black px-2.5 py-1 text-xs font-medium text-white">
                Future-proof
              </span>
            ) : (
              <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                APS-C focused
              </span>
            )}
          </div>

          <div class="mt-4 space-y-2 text-sm text-gray-700">
            <p>
              <span class="font-medium text-gray-900">Price:</span>
              {typeof lens.price === "number" ? ` $${lens.price.toLocaleString()}` : " Price varies"}
            </p>

            <p>
              <span class="font-medium text-gray-900">Weight:</span>
              {typeof lens.weightGrams === "number" ? ` ${lens.weightGrams}g` : " —"}
            </p>

            <p>
              <span class="font-medium text-gray-900">Type:</span>
              {lens.lensType || "—"}
            </p>
          </div>

          {Array.isArray(lens.strengths) && lens.strengths.length > 0 && (
            <div class="mt-4">
              <p class="text-sm font-medium text-gray-900">Why it stands out</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-700">
                {lens.strengths.slice(0, 3).map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}

          {Array.isArray(lens.tradeoffs) && lens.tradeoffs.length > 0 && (
            <div class="mt-4">
              <p class="text-sm font-medium text-gray-900">Tradeoffs</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-700">
                {lens.tradeoffs.slice(0, 2).map((item) => <li>{item}</li>)}
              </ul>
            </div>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {lens.buyLinks?.bh && (
              <a
                href={lens.buyLinks.bh}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-xl bg-black px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-900"
              >
                View at B&H
              </a>
            )}

            {lens.buyLinks?.used && (
              <a
                href={lens.buyLinks.used}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-xl border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 transition hover:bg-gray-50"
              >
                View used
              </a>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Works well with these cameras</h2>
      <p class="mt-2 text-sm text-gray-600">
        Popular Canon mirrorless bodies that use RF lenses.
      </p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {canonRFBodies.map((camera) => (
          <a
            href="/cameras"
            class="rounded-xl border border-gray-200 p-4 transition hover:bg-gray-50"
          >
            <p class="font-medium text-gray-900">{camera.brand} {camera.model}</p>

            <p class="mt-1 text-sm text-gray-600">
              {camera.sensor} • {typeof camera.price === "number"
                ? `$${camera.price.toLocaleString()}`
                : "—"}
            </p>
          </a>
        ))}
      </div>
    </section>

    <section class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
      <h2 class="text-lg font-semibold text-gray-900">RF vs RF-S lenses</h2>

      <p class="mt-2 text-sm text-gray-700">
        RF lenses are designed for Canon’s full-frame mirrorless system and are the most future-proof
        option if you may upgrade later. RF-S lenses are made for APS-C Canon mirrorless cameras like
        the R50, R10, and R7. They are often smaller and more affordable, but they are less ideal if
        you plan to move to full frame.
      </p>
    </section>
  </div>

  <script is:inline>
    (() => {
      const grid = document.getElementById("lensGrid");
      const categoryFilter = document.getElementById("lensCategoryFilter");
      const sortSelect = document.getElementById("lensSort");

      if (!grid || !categoryFilter || !sortSelect) return;

      const cards = Array.from(grid.querySelectorAll(".lens-card"));

      function getNum(value, fallback) {
        const n = Number(value);
        return Number.isFinite(n) ? n : fallback;
      }

      function applyFilters() {
        const category = categoryFilter.value;
        const sort = sortSelect.value;

        cards.forEach((card) => {
          const cardCategory = card.dataset.category || "";
          const show = category === "all" || cardCategory === category;
          card.style.display = show ? "" : "none";
        });

        const visibleCards = cards.filter((card) => card.style.display !== "none");

        visibleCards.sort((a, b) => {
          const aPrice = getNum(a.dataset.price, 999999);
          const bPrice = getNum(b.dataset.price, 999999);
          const aWeight = getNum(a.dataset.weight, 999999);
          const bWeight = getNum(b.dataset.weight, 999999);

          if (sort === "price-asc") return aPrice - bPrice;
          if (sort === "price-desc") return bPrice - aPrice;
          if (sort === "weight-asc") return aWeight - bWeight;
          if (sort === "weight-desc") return bWeight - aWeight;
          return 0;
        });

        visibleCards.forEach((card) => grid.appendChild(card));
      }

      categoryFilter.addEventListener("change", applyFilters);
      sortSelect.addEventListener("change", applyFilters);
    })();
  </script>
</BaseLayout>